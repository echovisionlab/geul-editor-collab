{
  "name": "@echovisionlab/geul-editor-collab",
  "version": "0.2.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/echovisionlab/geul-editor-collab.git"
  },
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "build:local-dependencies": "tsup --tsconfig tsconfig.local-dependencies.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:local-dependencies": "tsc --noEmit -p tsconfig.local-dependencies.json",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "ops:replay-projection-dlq": "tsx scripts/ops/replay-file-ingest-projection-dlq.ts",
    "unused": "knip --reporter symbols",
    "test": "vitest run",
    "test:local-dependencies": "vitest run --config vitest.local-dependencies.config.mjs",
    "test:ci-scripts": "node --test scripts/ci/*.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:coverage:local-dependencies": "vitest run --coverage --config vitest.local-dependencies.config.mjs",
    "test:watch": "vitest",
    "smoke:release-syntax": "node --check dist/index.js",
    "smoke:release-dependencies": "node scripts/ci/verify-bundled-dependencies.mjs"
  },
  "knip": {
    "entry": [
      "benchmarks/block-overhaul-benchmark.ts"
    ]
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@echovisionlab/geul-common": "0.2.1",
    "@echovisionlab/geul-event": "0.2.0",
    "@echovisionlab/geul-proto": "0.2.0",
    "@echovisionlab/geul-telemetry": "0.1.0",
    "@hocuspocus/server": "^4.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tiptap/core": "3.30.1",
    "@tiptap/pm": "3.30.1",
    "@tiptap/static-renderer": "3.30.1",
    "jsdom": "^30.0.1",
    "katex": "^0.18.4",
    "pg": "^8.23.0",
    "shiki": "^4.4.3",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.0",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "knip": "^6.32.2",
    "lib0": "0.2.117",
    "prettier": "3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
