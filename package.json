{
  "name": "@echovisionlab/geul-editor-collab",
  "version": "0.3.2",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/echovisionlab/geul-editor-collab.git"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "build:local-dependencies": "tsup --tsconfig tsconfig.local-dependencies.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:local-dependencies": "tsc --noEmit -p tsconfig.local-dependencies.json",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "ops:replay-projection-dlq": "tsx scripts/ops/replay-file-ingest-projection-dlq.ts",
    "unused": "knip --reporter symbols",
    "test": "vitest run",
    "test:local-dependencies": "vitest run --config vitest.local-dependencies.config.mjs",
    "test:ci-scripts": "node --test scripts/ci/*.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:coverage:local-dependencies": "vitest run --coverage --config vitest.local-dependencies.config.mjs",
    "test:watch": "vitest",
    "smoke:release-syntax": "node --check dist/index.js",
    "smoke:release-dependencies": "node scripts/ci/verify-bundled-dependencies.mjs"
  },
  "knip": {
    "entry": [
      "benchmarks/block-overhaul-benchmark.ts"
    ]
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@echovisionlab/geul-common": "0.3.2",
    "@echovisionlab/geul-event": "0.4.1",
    "@echovisionlab/geul-proto": "0.4.1",
    "@echovisionlab/geul-telemetry": "0.1.4",
    "@hocuspocus/server": "^4.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/static-renderer": "3.31.4",
    "jsdom": "^30.1.2",
    "katex": "^0.19.0",
    "pg": "^8.23.1",
    "shiki": "^4.5.0",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "knip": "^6.39.0",
    "lib0": "0.2.119",
    "prettier": "3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
